{
    "name": "ulrischa/markydown",
    "description": "Convert HTML to Markdown and serve selected page content through HTTP content negotiation",
    "type": "library",
    "require": {
        "php": "^8.3",
        "fivefilters/readability.php": "^3.1.7",
        "league/html-to-markdown": "^5.1",
        "ezyang/htmlpurifier": "^4.18",
        "symfony/css-selector": "^7.4",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-xml": "*",
        "league/uri": "^6.7.2",
        "masterminds/html5": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "ulrischa\\": "src/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Uli Schäffler",
            "email": "uli@ulrischa.de"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": false,
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@php tests/run.php",
            "@php tests/fetcher.php",
            "@php tests/http.php"
        ]
    }
}
